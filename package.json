{
  "name": "six-sense-navigation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:import-navigation": "python scripts/navigation/import-graph.py --apply --replace",
    "db:import-navigation:dry-run": "python scripts/navigation/import-graph.py",
