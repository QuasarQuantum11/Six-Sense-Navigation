    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vercel/functions": "^3.3.3",
    "drizzle-orm": "^0.45.1",
    "jose": "^6.2.10",
    "leaflet": "^1.9.4",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^59.5.0",
    "vitest": "^4.1.11"
  }
